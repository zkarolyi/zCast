[Unit]
Description=zCast - self-hosted vTuner replacement for AVRs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zcast
ExecStart=/opt/zcast/web
# Only reachable through nginx, which owns port 80.
Environment=ASPNETCORE_URLS=http://127.0.0.1:8010
Environment=ASPNETCORE_ENVIRONMENT=Production
# Workstation GC keeps memory low next to other services.
Environment=DOTNET_gcServer=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Run as an unprivileged throwaway user; the app only needs to read /opt/zcast.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
